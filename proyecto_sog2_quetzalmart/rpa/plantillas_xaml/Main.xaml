<Activity mc:Ignorable="sap sap2010" x:Class="Main" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Text</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>UiPath.Excel</x:String>
      <x:String>UiPath.Excel.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.Collections</AssemblyReference>
      <AssemblyReference>System.IO.Compression</AssemblyReference>
      <AssemblyReference>System.IO.Compression.ZipFile</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>System.Private.Xml.Linq</AssemblyReference>
      <AssemblyReference>System.Text.RegularExpressions</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UiAutomation.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="QuetzalMart - Robot de carga de clientes y productos">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="https://CAMBIAR-POR-EL-DOMINIO-DE-ODOO" Name="urlOdoo" />
      <Variable x:TypeArguments="x:String" Name="carpetaRaiz" />
      <Variable x:TypeArguments="x:String" Name="carpetaSalida" />
      <Variable x:TypeArguments="s:String[]" Name="archivos" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtClientes" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtProductos" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtReporte" />
      <Variable x:TypeArguments="x:String" Name="archivoClientes" />
      <Variable x:TypeArguments="x:String" Name="archivoProductos" />
      <Variable x:TypeArguments="x:Int32" Name="hojasProcesadas" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Inicio del robot" Level="Info" Message="[&quot;QuetzalMart RPA: inicio &quot; + Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)]" />
    <ui:SelectFolder DisplayName="1. Pedir la carpeta raíz entregada por el auxiliar" SelectedFolder="[carpetaRaiz]" />
    <Assign DisplayName="Carpeta de salida (Documentos\QuetzalMart_RPA\fecha)">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[carpetaSalida]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[Directory.CreateDirectory(Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "QuetzalMart_RPA", Now.ToString("yyyyMMdd_HHmmss"))).FullName]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="2. Buscar todos los Excel en la carpeta y subcarpetas">
      <Assign.To>
        <OutArgument x:TypeArguments="s:String[]">[archivos]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="s:String[]">[Directory.GetFiles(carpetaRaiz, "*.xls*", SearchOption.AllDirectories).Where(Function(ruta) Not Path.GetFileName(ruta).StartsWith("~$")).OrderBy(Function(ruta) ruta).ToArray()]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="Cantidad de archivos" Level="Info" Message="[&quot;Archivos de Excel encontrados: &quot; + archivos.Length.ToString]" />
    <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="Crear tabla de reporte" Language="VBNet" Code="__CODIGO_CrearReporte__">
      <ui:InvokeCode.Arguments>
        <OutArgument x:TypeArguments="sd:DataTable" x:Key="dtReporte">[dtReporte]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="3. Recorrer cada archivo de Excel" Values="[archivos]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="archivo" />
          </ActivityAction.Argument>
          <TryCatch DisplayName="Procesar archivo (si falla, se registra y sigue con el siguiente)">
            <TryCatch.Try>
              <Sequence DisplayName="Procesar archivo">
                <Sequence.Variables>
                  <Variable x:TypeArguments="s:String[]" Name="hojas" />
                </Sequence.Variables>
                <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="4. Listar las hojas del libro en orden" Language="VBNet" Code="__CODIGO_ListarHojas__">
                  <ui:InvokeCode.Arguments>
                    <InArgument x:TypeArguments="x:String" x:Key="rutaArchivo">[archivo]</InArgument>
                    <OutArgument x:TypeArguments="s:String[]" x:Key="hojas">[hojas]</OutArgument>
                  </ui:InvokeCode.Arguments>
                </ui:InvokeCode>
                <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="Buscar hojas clientes y productos" Values="[{&quot;clientes&quot;, &quot;productos&quot;}]">
                  <ui:ForEach.Body>
                    <ActivityAction x:TypeArguments="x:String">
                      <ActivityAction.Argument>
                        <DelegateInArgument x:TypeArguments="x:String" Name="tipo" />
                      </ActivityAction.Argument>
                      <Sequence DisplayName="Procesar hoja">
                        <Sequence.Variables>
                          <Variable x:TypeArguments="x:String" Name="hoja" />
                          <Variable x:TypeArguments="x:Int32" Name="posicion" />
                          <Variable x:TypeArguments="sd:DataTable" Name="dtHoja" />
                          <Variable x:TypeArguments="x:Int32" Name="agregados" />
                          <Variable x:TypeArguments="x:Int32" Name="omitidos" />
                        </Sequence.Variables>
                        <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="5. Elegir la hoja (5.a posición o por nombre)" Language="VBNet" Code="__CODIGO_ElegirHoja__">
                          <ui:InvokeCode.Arguments>
                            <InArgument x:TypeArguments="s:String[]" x:Key="hojas">[hojas]</InArgument>
                            <InArgument x:TypeArguments="x:String" x:Key="tipo">[tipo]</InArgument>
                            <OutArgument x:TypeArguments="x:String" x:Key="hoja">[hoja]</OutArgument>
                            <OutArgument x:TypeArguments="x:Int32" x:Key="posicion">[posicion]</OutArgument>
                          </ui:InvokeCode.Arguments>
                        </ui:InvokeCode>
                        <If Condition="[hoja &lt;&gt; &quot;&quot;]" DisplayName="¿El libro tiene esta hoja?">
                          <If.Then>
                            <Sequence DisplayName="Leer y normalizar la hoja">
                              <ui:ReadRange AddHeaders="True" DataTable="[dtHoja]" DisplayName="6. Leer la hoja (sin abrir Excel)" SheetName="[hoja]" WorkbookPath="[archivo]">
                                <ui:ReadRange.Range>
                                  <InArgument x:TypeArguments="x:String">
                                    <Literal x:TypeArguments="x:String" Value="" />
                                  </InArgument>
                                </ui:ReadRange.Range>
                              </ui:ReadRange>
                              <If Condition="[tipo = &quot;clientes&quot;]" DisplayName="¿Clientes o productos?">
                                <If.Then>
                                  <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="7a. Normalizar clientes y agregar al consolidado" Language="VBNet" Code="__CODIGO_NormalizarClientes__">
                                    <ui:InvokeCode.Arguments>
                                      <InArgument x:TypeArguments="sd:DataTable" x:Key="dtEntrada">[dtHoja]</InArgument>
                                      <InArgument x:TypeArguments="x:String" x:Key="archivoOrigen">[archivo]</InArgument>
                                      <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtConsolidado">[dtClientes]</InOutArgument>
                                      <OutArgument x:TypeArguments="x:Int32" x:Key="agregados">[agregados]</OutArgument>
                                      <OutArgument x:TypeArguments="x:Int32" x:Key="omitidos">[omitidos]</OutArgument>
                                    </ui:InvokeCode.Arguments>
                                  </ui:InvokeCode>
                                </If.Then>
                                <If.Else>
                                  <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="7b. Normalizar productos y agregar al consolidado" Language="VBNet" Code="__CODIGO_NormalizarProductos__">
                                    <ui:InvokeCode.Arguments>
                                      <InArgument x:TypeArguments="sd:DataTable" x:Key="dtEntrada">[dtHoja]</InArgument>
                                      <InArgument x:TypeArguments="x:String" x:Key="archivoOrigen">[archivo]</InArgument>
                                      <InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtConsolidado">[dtProductos]</InOutArgument>
                                      <OutArgument x:TypeArguments="x:Int32" x:Key="agregados">[agregados]</OutArgument>
                                      <OutArgument x:TypeArguments="x:Int32" x:Key="omitidos">[omitidos]</OutArgument>
                                    </ui:InvokeCode.Arguments>
                                  </ui:InvokeCode>
                                </If.Else>
                              </If>
                              <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{archivo, hoja, posicion.ToString, tipo, agregados.ToString, omitidos.ToString, &quot;procesada&quot;}]" DataTable="[dtReporte]" DisplayName="Anotar en el reporte" />
                              <Assign DisplayName="Contar hojas procesadas">
                                <Assign.To>
                                  <OutArgument x:TypeArguments="x:Int32">[hojasProcesadas]</OutArgument>
                                </Assign.To>
                                <Assign.Value>
                                  <InArgument x:TypeArguments="x:Int32">[hojasProcesadas + 1]</InArgument>
                                </Assign.Value>
                              </Assign>
                              <ui:LogMessage DisplayName="Hoja procesada" Level="Info" Message="[Path.GetFileName(archivo) + &quot; -&gt; hoja '&quot; + hoja + &quot;' (posición &quot; + posicion.ToString + &quot;): &quot; + agregados.ToString + &quot; agregados, &quot; + omitidos.ToString + &quot; omitidos&quot;]" />
                            </Sequence>
                          </If.Then>
                        </If>
                      </Sequence>
                    </ActivityAction>
                  </ui:ForEach.Body>
                </ui:ForEach>
              </Sequence>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="excepcion" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Registrar archivo con error">
                    <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{archivo, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;0&quot;, &quot;0&quot;, &quot;error: &quot; + excepcion.Message}]" DataTable="[dtReporte]" DisplayName="Anotar el error en el reporte" />
                    <ui:LogMessage DisplayName="Aviso de archivo omitido" Level="Warn" Message="[&quot;Se omitió &quot; + archivo + &quot;: &quot; + excepcion.Message]" />
                  </Sequence>
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <If Condition="[dtClientes IsNot Nothing AndAlso dtClientes.Rows.Count &gt; 0]" DisplayName="¿Hay clientes para cargar?">
      <If.Then>
        <Sequence DisplayName="Cargar clientes en Odoo">
          <Assign DisplayName="Ruta del consolidado de clientes">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[archivoClientes]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[Path.Combine(carpetaSalida, "consolidado_clientes.xlsx")]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:WriteRange AddHeaders="True" DataTable="[dtClientes]" DisplayName="8a. Escribir consolidado_clientes.xlsx" SheetName="clientes" StartingCell="A1" WorkbookPath="[archivoClientes]" />
          <ui:InvokeWorkflowFile DisplayName="9a. Importar clientes con la interfaz de Odoo" WorkflowFileName="ImportarEnOdoo.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_Url">[urlOdoo + "/odoo/contacts/import?active_model=res.partner"]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Archivo">[archivoClientes]</InArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
        </Sequence>
      </If.Then>
    </If>
    <If Condition="[dtProductos IsNot Nothing AndAlso dtProductos.Rows.Count &gt; 0]" DisplayName="¿Hay productos para cargar?">
      <If.Then>
        <Sequence DisplayName="Cargar productos en Odoo">
          <Assign DisplayName="Ruta del consolidado de productos">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[archivoProductos]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[Path.Combine(carpetaSalida, "consolidado_productos.xlsx")]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:WriteRange AddHeaders="True" DataTable="[dtProductos]" DisplayName="8b. Escribir consolidado_productos.xlsx" SheetName="productos" StartingCell="A1" WorkbookPath="[archivoProductos]" />
          <ui:InvokeWorkflowFile DisplayName="9b. Importar productos con la interfaz de Odoo" WorkflowFileName="ImportarEnOdoo.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_Url">[urlOdoo + "/odoo/action-sale.product_template_action/import?active_model=product.template"]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Archivo">[archivoProductos]</InArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
        </Sequence>
      </If.Then>
    </If>
    <ui:WriteRange AddHeaders="True" DataTable="[dtReporte]" DisplayName="10. Guardar reporte_robot.xlsx" SheetName="reporte" StartingCell="A1" WorkbookPath="[Path.Combine(carpetaSalida, &quot;reporte_robot.xlsx&quot;)]" />
    <ui:MessageBox Caption="QuetzalMart RPA" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Resumen final" Text="[&quot;Robot terminado.&quot; + vbCrLf + &quot;Archivos revisados: &quot; + archivos.Length.ToString + vbCrLf + &quot;Hojas cargadas: &quot; + hojasProcesadas.ToString + vbCrLf + &quot;Clientes: &quot; + If(dtClientes Is Nothing, &quot;0&quot;, dtClientes.Rows.Count.ToString) + vbCrLf + &quot;Productos: &quot; + If(dtProductos Is Nothing, &quot;0&quot;, dtProductos.Rows.Count.ToString) + vbCrLf + &quot;Reporte y consolidados en: &quot; + carpetaSalida]" />
  </Sequence>
</Activity>
