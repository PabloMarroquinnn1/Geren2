# Caddy obtiene y renueva el certificado HTTPS (Let's Encrypt) solo.
{$DOMINIO} {
	encode gzip

	request_body {
		max_size 100MB
	}

	# Canal en tiempo real de Odoo (chat, notificaciones).
	@websocket path /websocket*
	reverse_proxy @websocket odoo:8072

	reverse_proxy odoo:8069 {
		transport http {
			read_timeout 600s
		}
	}
}
