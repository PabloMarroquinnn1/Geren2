# Copia este archivo como .env (instalar.sh lo hace por ti y genera las claves).
# No subas el .env al repositorio: contiene contraseñas.

# Dominio público. Opciones gratuitas:
#   - sslip.io con la IP pública de la VM: quetzalmart.20-55-10-7.sslip.io
#   - Etiqueta DNS de Azure: quetzalmart-g1.eastus.cloudapp.azure.com
DOMINIO=quetzalmart.20-55-10-7.sslip.io

BD_NOMBRE=quetzalmart
POSTGRES_PASSWORD=cambiar
ODOO_MASTER_PASSWORD=cambiar
ODOO_ADMIN_LOGIN=admin@quetzalmart.com
ODOO_ADMIN_PASSWORD=cambiar

# Clave del usuario de PostgreSQL de solo lectura para las consultas SQL de la calificación.
CONSULTA_PASSWORD=cambiar
