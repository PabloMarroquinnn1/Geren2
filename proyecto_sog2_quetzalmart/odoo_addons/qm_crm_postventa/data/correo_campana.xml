<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Correo 2: campaña de marketing que llega después del comprobante. -->
    <record id="plantilla_campana_postcompra" model="mail.template">
        <field name="name">QuetzalMart: campaña postcompra</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="email_from">{{ object.company_id.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="subject">🎁 {{ (object.partner_id.name or '').split(' ')[0] }}, tu próxima compra en QuetzalMart tiene 10% de descuento</field>
        <field name="description">Campaña de marketing enviada a cada cliente después de su compra en línea.</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
<div style="margin:0;padding:0;background-color:#F3EFE3;font-family:Arial,Helvetica,sans-serif;color:#1f2a24;">
    <t t-set="utm" t-value="'utm_source=correo_postcompra&amp;utm_medium=email&amp;utm_campaign=temporada_quetzalmart'"/>
    <t t-set="tienda" t-value="'/shop?' + utm"/>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;border-collapse:collapse;background-color:#ffffff;">
        <tr>
            <td style="background-color:#064635;padding:14px 24px;">
                <img src="/qm_crm_postventa/static/img/logo_claro.png" alt="QuetzalMart" height="40" style="height:40px;vertical-align:middle;"/>
                <span style="float:right;color:#F2B705;font-size:12px;letter-spacing:2px;padding-top:14px;">TEMPORADA 2026</span>
            </td>
        </tr>
        <tr>
            <td style="padding:0;">
                <a t-att-href="tienda"><img src="/qm_crm_postventa/static/img/campana_hero.png" alt="Temporada QuetzalMart" width="600" style="display:block;width:100%;max-width:600px;border:0;"/></a>
            </td>
        </tr>
        <tr>
            <td style="padding:28px 30px 8px 30px;">
                <p style="font-size:20px;font-weight:bold;color:#0B6E4F;margin:0 0 10px 0;">
                    ¡Gracias por elegirnos, <t t-out="(object.partner_id.name or '').split(' ')[0]">Ana</t>!
                </p>
                <p style="font-size:15px;line-height:23px;margin:0;">
                    Tu pedido <strong t-out="object.name">S00001</strong> ya está en camino. Para celebrar que eres
                    parte de la familia QuetzalMart, tu próxima compra en línea tiene un descuento especial.
                </p>
            </td>
        </tr>
        <tr>
            <td style="padding:18px 30px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:separate;border:2px dashed #C8102E;border-radius:14px;background-color:#FFF8E7;">
                    <tr>
                        <td align="center" style="padding:18px;">
                            <span style="font-size:13px;color:#5b6b62;letter-spacing:1px;">TU CÓDIGO DE DESCUENTO</span><br/>
                            <span style="font-size:34px;font-weight:bold;color:#C8102E;letter-spacing:4px;">QUETZAL10</span><br/>
                            <span style="font-size:14px;color:#1f2a24;">10% en toda tu próxima compra en línea</span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="padding:6px 30px 0 30px;">
                <p style="font-size:16px;font-weight:bold;color:#064635;margin:0 0 12px 0;">Te puede gustar</p>
            </td>
        </tr>
        <tr>
            <td style="padding:0 22px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                    <tr>
                        <t t-foreach="object.qm_recomendaciones()" t-as="producto">
                            <td width="33%" valign="top" align="center" style="padding:8px;">
                                <a t-att-href="producto.website_url + '?' + utm" style="text-decoration:none;color:#1f2a24;">
                                    <img t-att-src="'/web/image/product.template/%s/image_256' % producto.id" t-att-alt="producto.name"
                                         width="150" style="width:150px;height:150px;object-fit:contain;border-radius:12px;background-color:#F7F7F2;border:0;"/>
                                    <div style="font-size:13px;line-height:17px;margin-top:8px;min-height:34px;" t-out="producto.name">Producto</div>
                                    <div style="font-size:15px;font-weight:bold;color:#0B6E4F;margin-top:4px;"
                                         t-out="format_amount(producto.taxes_id.compute_all(producto.list_price)['total_included'], object.currency_id)">Q 10.00</div>
                                </a>
                            </td>
                        </t>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td align="center" style="padding:24px 30px 30px 30px;">
                <a t-att-href="tienda"
                   style="background-color:#C8102E;color:#ffffff;text-decoration:none;padding:14px 34px;border-radius:28px;font-weight:bold;font-size:15px;display:inline-block;">
                    Usar mi descuento ahora
                </a>
            </td>
        </tr>
        <tr>
            <td style="padding:0 30px 24px 30px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:12px;color:#33433a;">
                    <tr>
                        <td width="33%" align="center" style="padding:10px;background-color:#EAF4EE;border-radius:10px;">🇬🇹<br/><strong>Guatemala</strong><br/>Zona 4, Ciudad de Guatemala</td>
                        <td width="2%"></td>
                        <td width="33%" align="center" style="padding:10px;background-color:#EAF4EE;border-radius:10px;">🇲🇽<br/><strong>México</strong><br/>Tapachula, Chiapas</td>
                        <td width="2%"></td>
                        <td width="33%" align="center" style="padding:10px;background-color:#EAF4EE;border-radius:10px;">🇸🇻<br/><strong>El Salvador</strong><br/>Santa Ana</td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="background-color:#064635;color:#cfe3d8;padding:18px 30px;font-size:11px;line-height:17px;">
                Recibes este correo porque compraste en la tienda en línea de QuetzalMart.
                Código válido para compras en línea; no acumulable con otras promociones.
            </td>
        </tr>
    </table>
</div>
        </field>
    </record>
</odoo>
